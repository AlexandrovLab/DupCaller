// Config overlay for running nextflow/DupCaller.nf against the synthetic
// dataset in data/ (see run_nextflow_pipeline.sh). Layered on top of
// nextflow/nextflow.config via `-c`, so it only needs to override what the
// tiny mock dataset actually requires: params for this dataset's regions/
// files, and per-process memory caps well below the production defaults
// (nextflow/nextflow.config asks for up to 32 GB per process, sized for
// real genomes -- more than a CI runner or laptop typically has to spare,
// and unnecessary for ~100 reads).
params {
    sample_map = "sample.map"
    outdir     = "./results"

    reference  = "reference.fa"
    skip_index = false
    repeat_tsv = "repeats.tsv"

    germline_vcf = null
    noise_mask   = null
    target_bed   = null
    indel_bed    = null
    gene_bed     = null

    barcode_pattern = "NNNXXXX"
    regions         = "mockchr1"

    threads  = 1
    max_cpus = 1

    max_af             = 1.0
    germline_af_cutoff = 0.001
    min_n_depth        = 1
    trim_template      = 7
    trim_read          = 7
    mapq               = 0

    estimate_clonal = false
    estimate_dilute = false
}

// Some environments under-report free memory to Nextflow's local executor
// (e.g. a fixed low ceiling regardless of actual host RAM); raise its pool
// explicitly so the per-process caps below are never rejected at
// scheduling time even when that happens.
executor {
    $local {
        memory = '16 GB'
    }
}

process {
    withName: 'INDEX_REFERENCE'  { memory = '256 MB' }
    withName: 'TRIM_BARCODES'    { memory = '256 MB' }
    withName: 'BWA_MEM'          { memory = '256 MB' }
    withName: 'SAMTOOLS_SORT'    { memory = '256 MB' }
    withName: 'MARK_DUPLICATES'  { memory = '4 GB' }   // GATK's JVM needs real headroom even for a tiny BAM
    withName: 'CALL_VARIANTS'    { memory = '512 MB' }
    withName: 'ESTIMATE_BURDEN'  { memory = '256 MB' }
}

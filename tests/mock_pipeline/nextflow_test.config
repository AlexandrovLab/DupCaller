// Config overlay for running nextflow/DupCaller.nf against the synthetic
// dataset in data/ (see run_nextflow_pipeline.sh). Layered on top of
// nextflow/nextflow.config via `-c`; overrides only this dataset's params
// and per-process memory caps far below the production defaults (sized for
// real genomes, unnecessary for ~100 reads).
params {
    sample_map = "sample.map"
    outdir     = "./results"

    reference      = "reference.fa"
    skip_index     = false
    skip_bwa_index = false
    repeat_tsv     = "repeats.tsv"

    germline_vcf = null
    noise_mask   = null
    target_bed   = null
    indel_bed    = null
    gene_bed     = null

    barcode_pattern = "NNNXXXX"
    regions         = "mockchr1"

    threads  = 1
    max_cpus = 1

    max_af             = 1.0
    germline_af_cutoff = 0.001
    min_n_depth        = 1
    trim_template      = 7
    trim_read          = 7
    mapq               = 0

    estimate_dilute = false

    // Pinned so the default case is deterministic and can be compared
    // against expected_matched_normal/ (run_pipeline.sh MATCHED_NORMAL=1).
    seed = 1
}

// Some environments under-report free memory to Nextflow's local executor;
// set its pool explicitly so the per-process caps below are never rejected
// at scheduling time.
executor {
    $local {
        memory = '16 GB'
    }
}

process {
    withName: 'INDEX_REFERENCE'  { memory = '256 MB' }
    withName: 'TRIM_BARCODES'    { memory = '256 MB' }
    withName: 'BWA_MEM2_INDEX'   { memory = '256 MB' }
    withName: 'BWA_MEM2'         { memory = '256 MB' }
    withName: 'SAMTOOLS_SORT'    { memory = '256 MB' }
    withName: 'MARK_DUPLICATES'  { memory = '4 GB' }   // GATK's JVM needs real headroom even for a tiny BAM
    withName: 'CALL_VARIANTS'    { memory = '512 MB' }
    withName: 'ESTIMATE_BURDEN'  { memory = '256 MB' }
}

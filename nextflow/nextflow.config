/*
 * DupCaller Nextflow base configuration
 * Container images and resource limits.
 * User settings live in pipeline.config — pass with: -c pipeline.config
 */

// Do NOT default outdir/max_memory/max_cpus/max_time here (pipeline.config
// supplies them).

// Each directive closure passes its own params (p): inside this method,
// `params` is this file's snapshot, which lacks the max_* set by a later
// -c file such as pipeline.config, so the caps would silently not apply.
def check_max(obj, type, p) {
    // Check for an unset p.max_* before casting: an exception from the
    // cast can leave the enclosing directive null even though catch
    // returns obj.
    if (type == 'memory') {
        if (!p.max_memory) return obj
        try {
            def limit = p.max_memory as nextflow.util.MemoryUnit
            return obj.compareTo(limit) == 1 ? limit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        if (!p.max_time) return obj
        try {
            def limit = p.max_time as nextflow.util.Duration
            return obj.compareTo(limit) == 1 ? limit : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        if (!p.max_cpus) return obj
        try { return Math.min(obj as int, p.max_cpus as int) }
        catch (all) { return obj }
    }
}

// The DupCaller image: params.dupcaller_container if set, else dflt.
// Nextflow also evaluates the container closures once before params are
// bound (for workflow.container), where reading an unset param logs a
// warning, hence containsKey.
def dupcaller_image(p, dflt) {
    (p.containsKey('dupcaller_container') && p.dupcaller_container) ? p.dupcaller_container.toString() : dflt
}

// Scheduler params: `--x null` / `--x ''` on the command line arrive as the
// string 'null' / boolean true, so treat those (and '') as unset.
def scheduler_opt(v) {
    (v == null || v instanceof Boolean || v.toString() in ['', 'null']) ? null : v.toString()
}

// ─── Docker images ────────────────────────────────────────────────────────────
// Pinned by digest (the tag is in the comment): a digest is immutable, while
// a tag can be re-pushed. Digest only, no tag: Singularity rejects
// references with both. Third-party images come from quay.io, which has no
// tight anonymous pull limit like Docker Hub's.
def IMG_BWA_MEM2 = 'quay.io/biocontainers/bwa-mem2@sha256:374f4b910b4b04d32772fccd4cab1cdcd0758356856a960cfa8b1edebfd38c9f'  // 2.3--he70b90d_0
// bwa-mem2 piped into samtools sort needs both in one image: nf-core
// bwamem2/mem's Seqera Community image (bwa-mem2 2.3, htslib + samtools 1.22.1).
def IMG_BWA_MEM2_SAMTOOLS = 'community.wave.seqera.io/library/bwa-mem2_htslib_samtools@sha256:5ebd1290d9680195817ce75915b79ae2e608834c017824b7e2bc7b141509b242'  // db98f81f55b64113
def IMG_GATK     = 'quay.io/biocontainers/gatk4@sha256:49f91bc0fcb704271c18a519715bf161141c0a00be4cf49c7ef2866de1f59a46'     // 4.3.0.0--py36hdfd78af_0
// The DupCaller image tag is defined here only: DupCaller.nf sets no
// container itself, and the manifest version below follows it. The image is
// built from the tagged source and published to the AlexandrovLab GHCR
// package by .github/workflows/release.yml (anonymous pulls). It is pinned
// by tag because its digest is only known after that release build.
// params.dupcaller_container (e.g. --dupcaller_container /path/to/image.sif,
// or CI's image built from the checked-out commit) replaces it in every
// process below.
def DUPCALLER_VERSION = '1.2.12'
def IMG_DUPCALLER = "ghcr.io/alexandrovlab/dupcaller:${DUPCALLER_VERSION}"

// ─── Process defaults and per-process resources ───────────────────────────────
process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'INDEX_REFERENCE' {
        container = { dupcaller_image(params, IMG_DUPCALLER) }
        cpus      = 1
        memory    = '8 GB'
        time      = '4 h'
    }
    // Times and memory below are sized for whole-genome duplex libraries
    // (~65 GB fq.gz per read: trim ~3 h, markdup ~7 h).
    withName: 'TRIM_BARCODES' {
        container = { dupcaller_image(params, IMG_DUPCALLER) }
        cpus      = 1
        memory    = '4 GB'
        time      = { check_max(12.h   * task.attempt, 'time', params) }
    }
    // premade: downloads need network access from wherever the task runs.
    // A failed download is retried after 1 and then 2 minutes (a Google
    // Drive download quota can last up to a day; see the README).
    withName: 'PREMADE_DOWNLOAD' {
        container     = { dupcaller_image(params, IMG_DUPCALLER) }
        cpus          = 1
        memory        = '2 GB'
        time          = { check_max(24.h, 'time', params) }
        maxForks      = 4
        errorStrategy = { sleep(60000L * task.attempt); 'retry' }
        maxRetries    = 2
    }
    withName: 'PREMADE_REFERENCE|PREMADE_CHECK_INDEX' {
        container = { dupcaller_image(params, IMG_DUPCALLER) }
        cpus      = 1
        memory    = '4 GB'
        time      = '4 h'
    }
    // bwa-mem2 index needs ~28 bytes of RAM per reference base (~90 GB
    // for GRCh38), so the request is sized from the FASTA plus 2 GB;
    // bwa-mem2 mem loads a ~16 GB index for GRCh38.
    withName: 'BWA_MEM2_INDEX|PREMADE_BWA_MEM2_INDEX' {
        container = IMG_BWA_MEM2
        cpus      = 1
        memory    = { check_max(new nextflow.util.MemoryUnit(28L * reference.size() + 2.GB.toBytes()) * task.attempt, 'memory', params) }
        time      = { check_max(12.h   * task.attempt, 'time', params)   }
    }
    // 32 GB for bwa-mem2 mem plus 1 GB per CPU for samtools sort (768 MB
    // per thread by default) running alongside it.
    withName: 'BWA_MEM2_SORT' {
        container = IMG_BWA_MEM2_SAMTOOLS
        cpus      = { check_max(params.threads, 'cpus', params)   }
        memory    = { check_max((32.GB + 1.GB * task.cpus) * task.attempt, 'memory', params) }
        time      = { check_max(24.h   * task.attempt, 'time', params)   }
    }
    withName: 'MARK_DUPLICATES' {
        container = IMG_GATK
        cpus      = 1
        memory    = { check_max(64.GB  * task.attempt, 'memory', params) }
        time      = { check_max(24.h   * task.attempt, 'time', params)   }
    }
    withName: 'CALL_VARIANTS' {
        container = { dupcaller_image(params, IMG_DUPCALLER) }
        cpus      = { check_max(params.threads, 'cpus', params)   }
        // 6 GB per CPU: whole-genome call peaks at ~2 GB per worker.
        memory    = { check_max(6.GB * task.cpus * task.attempt, 'memory', params) }
        time      = { check_max(96.h   * task.attempt, 'time', params)   }
    }
    withName: 'ESTIMATE_BURDEN' {
        container = { dupcaller_image(params, IMG_DUPCALLER) }
        cpus      = 1
        memory    = { check_max(8.GB   * task.attempt, 'memory', params) }
        time      = { check_max(4.h    * task.attempt, 'time', params)   }
    }
}

// ─── Execution profiles ───────────────────────────────────────────────────────
profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Scheduler profiles. Queue/partition, QOS, etc. come from the
    // matching params in pipeline.config (shipped as 'PLEASE CHANGE';
    // DupCaller.nf stops until they are set). params.cluster_options is
    // appended verbatim to every scheduler's submit flags (e.g. an account).
    // Only slurm has been run on a real cluster; lsf, sge, pbs, pbspro and
    // awsbatch are untested starting points.
    slurm {
        process {
            executor       = 'slurm'
            queue          = { scheduler_opt(params.slurm_queue) }
            clusterOptions = { def qos = scheduler_opt(params.slurm_qos)
                               [qos ? "--qos=${qos}" : null,
                                scheduler_opt(params.cluster_options)].findAll().join(' ') }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    // Nextflow reads LSF_UNIT_FOR_LIMITS / LSB_JOB_MEMLIMIT from lsf.conf
    // (via $LSF_ENVDIR) to size -M; if memory requests come out wrong, set
    // executor.perJobMemLimit or executor.perTaskReserve for your site.
    lsf {
        process {
            executor       = 'lsf'
            queue          = { scheduler_opt(params.lsf_queue) }
            clusterOptions = { scheduler_opt(params.cluster_options) ?: '' }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    // Multi-threaded tasks need a parallel environment (qconf -spl lists them).
    sge {
        process {
            executor       = 'sge'
            queue          = { scheduler_opt(params.sge_queue) }
            penv           = { scheduler_opt(params.sge_pe) }
            clusterOptions = { scheduler_opt(params.cluster_options) ?: '' }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    // pbs = Torque/OpenPBS-style; pbspro = PBS Pro (select=1:ncpus=:mem=).
    pbs {
        process {
            executor       = 'pbs'
            queue          = { scheduler_opt(params.pbs_queue) }
            clusterOptions = { scheduler_opt(params.cluster_options) ?: '' }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    pbspro {
        process {
            executor       = 'pbspro'
            queue          = { scheduler_opt(params.pbs_queue) }
            clusterOptions = { scheduler_opt(params.cluster_options) ?: '' }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    // Use alone (-profile awsbatch): Batch runs each process's container
    // itself, so do not add docker/singularity. Also needs -w s3://bucket/work,
    // a region (aws.region, AWS_REGION, or ~/.aws/config), and a compute
    // environment whose instances fit the largest request (BWA_MEM2_INDEX
    // asks for ~90 GB on GRCh38; skip_bwa_index = true with a pre-built
    // index avoids it). If the AMI's AWS CLI is not on PATH, set aws.batch.cliPath.
    awsbatch {
        process {
            executor = 'awsbatch'
            queue    = { scheduler_opt(params.awsbatch_queue) }
        }
        executor {
            queueSize = 50
        }
    }

    local {
        process.executor = 'local'
    }
}

// ─── Reporting ────────────────────────────────────────────────────────────────
// Disabled by default: Nextflow's process monitor requires 'ps' inside containers.
// Re-enable only when containers are known to include procps.
timeline { enabled = false }
report   { enabled = false }
trace    { enabled = false }
dag      { enabled = false }

// ─── Manifest ────────────────────────────────────────────────────────────────
manifest {
    name            = 'DupCaller'
    description     = 'Somatic mutation calling from barcoded ecNGS data'
    mainScript      = 'DupCaller.nf'
    // Exactly the range CI runs (.github/workflows/test.yml matrix); other
    // versions start with a warning and are untested.
    nextflowVersion = '>=23.10.1, <=24.10.4'
    version         = DUPCALLER_VERSION
}

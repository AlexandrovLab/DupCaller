/*
 * DupCaller Nextflow base configuration
 * Container images and resource limits.
 * User settings live in pipeline.config — pass with: -c pipeline.config
 */

// pipeline.config supplies outdir/max_memory/max_cpus/max_time -- do NOT
// also default them here. A param given a default in this same file, when
// also referenced inside a process-directive closure below (check_max),
// gets pinned to THIS file's own value and silently ignores pipeline.config/
// user -c overrides for that specific param -- only params never assigned a
// default in this file resolve the true final merged value. This bit us:
// max_cpus defaulted to 16 here, so every check_max(params.threads, 'cpus')
// call below capped at 16 regardless of pipeline.config's max_cpus=1 or any
// user override, while params.threads (no default here) resolved correctly.

def check_max(obj, type) {
    // Guard on falsiness before attempting the cast, rather than relying on
    // catch(all) to recover from an undefined params.max_* (a ConfigObject's
    // undefined-key placeholder, not null): letting the cast itself throw
    // and fall through to the catch block has been observed to leave the
    // enclosing directive (task.cpus/task.memory/task.time) resolved to
    // null even though this function's own catch clause returns `obj` --
    // avoiding the exception entirely instead of just handling it fixes it.
    if (type == 'memory') {
        if (!params.max_memory) return obj
        try {
            def limit = params.max_memory as nextflow.util.MemoryUnit
            return obj.compareTo(limit) == 1 ? limit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        if (!params.max_time) return obj
        try {
            def limit = params.max_time as nextflow.util.Duration
            return obj.compareTo(limit) == 1 ? limit : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        if (!params.max_cpus) return obj
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
}

// ─── Docker images ────────────────────────────────────────────────────────────
def IMG_BWA      = 'biocontainers/bwa:v0.7.17_cv1'
def IMG_GATK     = 'broadinstitute/gatk:4.3.0.0'
def IMG_DUPCALLER = 'yuhecheng62/dupcaller:1.2.1-dev'

// ─── Process defaults and per-process resources ───────────────────────────────
process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'INDEX_REFERENCE' {
        container = IMG_DUPCALLER
        cpus      = 1
        memory    = '8 GB'
        time      = '4 h'
    }
    withName: 'TRIM_BARCODES' {
        container = IMG_DUPCALLER
        cpus      = 1
        memory    = '4 GB'
        time      = '4 h'
    }
    withName: 'BWA_MEM' {
        container = IMG_BWA
        cpus      = { check_max(params.threads,          'cpus')   }
        memory    = { check_max(16.GB  * task.attempt,   'memory') }
        time      = { check_max(12.h   * task.attempt,   'time')   }
    }
    withName: 'SAMTOOLS_SORT' {
        container = IMG_GATK
        cpus      = { check_max(params.threads,          'cpus')   }
        memory    = { check_max(8.GB   * task.attempt,   'memory') }
        time      = { check_max(4.h    * task.attempt,   'time')   }
    }
    withName: 'MARK_DUPLICATES' {
        container = IMG_GATK
        cpus      = 1
        memory    = { check_max(16.GB  * task.attempt,   'memory') }
        time      = { check_max(8.h    * task.attempt,   'time')   }
    }
    withName: 'CALL_VARIANTS' {
        container = IMG_DUPCALLER
        cpus      = { check_max(params.threads,          'cpus')   }
        memory    = { check_max(32.GB  * task.attempt,   'memory') }
        time      = { check_max(48.h   * task.attempt,   'time')   }
    }
    withName: 'ESTIMATE_BURDEN' {
        container = IMG_DUPCALLER
        cpus      = 1
        memory    = { check_max(8.GB   * task.attempt,   'memory') }
        time      = { check_max(4.h    * task.attempt,   'time')   }
    }
}

// ─── Execution profiles ───────────────────────────────────────────────────────
profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        process {
            executor     = 'slurm'
            queue        = 'hotel'         // change to your partition
            clusterOptions = '--qos=hotel' // change to your QOS
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    local {
        process.executor = 'local'
    }
}

// ─── Reporting ────────────────────────────────────────────────────────────────
// Disabled by default: Nextflow's process monitor requires 'ps' inside containers.
// Re-enable only when containers are known to include procps.
timeline { enabled = false }
report   { enabled = false }
trace    { enabled = false }
dag      { enabled = false }

// ─── Manifest ────────────────────────────────────────────────────────────────
manifest {
    name            = 'DupCaller'
    description     = 'Somatic mutation calling from barcoded ecNGS data'
    mainScript      = 'DupCaller.nf'
    nextflowVersion = '>=21.10.0'
    version         = '1.2.1-dev'
}

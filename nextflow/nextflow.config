/*
 * DupCaller Nextflow base configuration
 * Container images and resource limits.
 * User settings live in pipeline.config — pass with: -c pipeline.config
 */

// Do NOT default outdir/max_memory/max_cpus/max_time here (pipeline.config
// supplies them): a param defaulted in this file and read inside a
// process-directive closure (check_max) keeps this file's value and ignores
// -c overrides.

def check_max(obj, type) {
    // Check for an unset params.max_* before casting: an exception from the
    // cast can leave the enclosing directive null even though catch
    // returns obj.
    if (type == 'memory') {
        if (!params.max_memory) return obj
        try {
            def limit = params.max_memory as nextflow.util.MemoryUnit
            return obj.compareTo(limit) == 1 ? limit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        if (!params.max_time) return obj
        try {
            def limit = params.max_time as nextflow.util.Duration
            return obj.compareTo(limit) == 1 ? limit : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        if (!params.max_cpus) return obj
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return obj }
    }
}

// ─── Docker images ────────────────────────────────────────────────────────────
def IMG_BWA_MEM2 = 'quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0'
def IMG_GATK     = 'broadinstitute/gatk:4.3.0.0'
// The DupCaller image tag is defined here only: DupCaller.nf sets no
// container itself, and the manifest version below follows it.
def DUPCALLER_VERSION = '1.2.12'
def IMG_DUPCALLER = "yuhecheng62/dupcaller:${DUPCALLER_VERSION}"

// ─── Process defaults and per-process resources ───────────────────────────────
process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'INDEX_REFERENCE' {
        container = IMG_DUPCALLER
        cpus      = 1
        memory    = '8 GB'
        time      = '4 h'
    }
    withName: 'TRIM_BARCODES' {
        container = IMG_DUPCALLER
        cpus      = 1
        memory    = '4 GB'
        time      = '4 h'
    }
    // bwa-mem2 index of a human genome needs ~90 GB of RAM (28N bytes,
    // N = reference length); bwa-mem2 mem loads a ~16 GB index for GRCh38.
    withName: 'BWA_MEM2_INDEX' {
        container = IMG_BWA_MEM2
        cpus      = 1
        memory    = { check_max(90.GB  * task.attempt,   'memory') }
        time      = { check_max(12.h   * task.attempt,   'time')   }
    }
    withName: 'BWA_MEM2' {
        container = IMG_BWA_MEM2
        cpus      = { check_max(params.threads,          'cpus')   }
        memory    = { check_max(32.GB  * task.attempt,   'memory') }
        time      = { check_max(12.h   * task.attempt,   'time')   }
    }
    withName: 'SAMTOOLS_SORT' {
        container = IMG_GATK
        cpus      = { check_max(params.threads,          'cpus')   }
        memory    = { check_max(8.GB   * task.attempt,   'memory') }
        time      = { check_max(4.h    * task.attempt,   'time')   }
    }
    withName: 'MARK_DUPLICATES' {
        container = IMG_GATK
        cpus      = 1
        memory    = { check_max(16.GB  * task.attempt,   'memory') }
        time      = { check_max(8.h    * task.attempt,   'time')   }
    }
    withName: 'CALL_VARIANTS' {
        container = IMG_DUPCALLER
        cpus      = { check_max(params.threads,          'cpus')   }
        memory    = { check_max(32.GB  * task.attempt,   'memory') }
        time      = { check_max(48.h   * task.attempt,   'time')   }
    }
    withName: 'ESTIMATE_BURDEN' {
        container = IMG_DUPCALLER
        cpus      = 1
        memory    = { check_max(8.GB   * task.attempt,   'memory') }
        time      = { check_max(4.h    * task.attempt,   'time')   }
    }
}

// ─── Execution profiles ───────────────────────────────────────────────────────
profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        process {
            executor     = 'slurm'
            queue        = 'hotel'         // change to your partition
            clusterOptions = '--qos=hotel' // change to your QOS
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    local {
        process.executor = 'local'
    }
}

// ─── Reporting ────────────────────────────────────────────────────────────────
// Disabled by default: Nextflow's process monitor requires 'ps' inside containers.
// Re-enable only when containers are known to include procps.
timeline { enabled = false }
report   { enabled = false }
trace    { enabled = false }
dag      { enabled = false }

// ─── Manifest ────────────────────────────────────────────────────────────────
manifest {
    name            = 'DupCaller'
    description     = 'Somatic mutation calling from barcoded ecNGS data'
    mainScript      = 'DupCaller.nf'
    nextflowVersion = '>=21.10.0'
    version         = DUPCALLER_VERSION
}

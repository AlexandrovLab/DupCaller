// ============================================================
// DupCaller Pipeline — User Configuration
// Fill in the paths below, then run:
//   nextflow run DupCaller.nf -c pipeline.config
// ============================================================

params {

    // ----------------------------------------------------------
    // Input: sample map (required)
    // Tab-separated file with a header row and columns:
    //   sample_id  tumor_fastq_1  tumor_fastq_2  normal_fastq_1  normal_fastq_2
    // ----------------------------------------------------------
    sample_map = "sample.map"

    // ----------------------------------------------------------
    // Output directory
    // ----------------------------------------------------------
    outdir = "./results"

    // ----------------------------------------------------------
    // Reference genome (required)
    // Must already be indexed with DupCaller.py index AND with bwa index.
    //   DupCaller index produces: reference.fa.ref.h5, reference.fa.tn.h5, reference.fa.hp.h5, reference.fa.str.h5, reference.fa.dbs.h5
    //   BWA index produces:       reference.fa.bwt, .pac, .ann, .amb, .sa
    //   samtools faidx produces:  reference.fa.fai
    // Set skip_index = false (and provide repeat_tsv) to run indexing as Step 1.
    // ----------------------------------------------------------
    reference  = null                        // path to your reference fasta -- required
    skip_index = true                        // set false to run DupCaller.py index as Step 1

    // Required only when skip_index = false:
    repeat_tsv = null                        // PERF-format repeat tsv (chrom, start, end, motif, length, strand, num_units, motif_repeat) for DupCaller.py index

    // ----------------------------------------------------------
    // Resource files
    // Leave null to omit; germline_vcf and noise_mask are strongly recommended.
    // All VCF/BED files must be tabix-indexed (companion .tbi required).
    // ----------------------------------------------------------
    germline_vcf = null   // tabix-indexed germline VCF with AF field
    noise_mask   = null  // tabix-indexed noise mask BED, or a list of several, e.g. ["snp_mask.bed.gz", "noise_mask.bed.gz"]
    target_bed   = null                           // optional: restrict to target regions (BED)
    indel_bed    = null                           // optional: indel enhanced PoN (BED.gz + .tbi)

    // ----------------------------------------------------------
    // Barcode pattern  (N = barcode base, X = skipped base)
    // NanoSeq default: NNNXXXX  (3-base barcode + 4 constant bases)
    // ----------------------------------------------------------
    barcode_pattern = "NNNXXXX"

    // ----------------------------------------------------------
    // Variant-calling regions
    // Default: human hg38 autosomes + X
    // Mouse example: "chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chrX"
    // ----------------------------------------------------------
    regions = "chr22"

    // ----------------------------------------------------------
    // Compute resources
    // ----------------------------------------------------------
    threads  = 1     // threads for BWA alignment and DupCaller variant calling
    max_cpus = 1
    max_memory = "16.GB"
    max_time   = "1.h"

    // ----------------------------------------------------------
    // Variant calling options (defaults are usually fine)
    // ----------------------------------------------------------
    max_af             = 1.0     // max allele fraction; set ~0.1 when no matched normal
    germline_af_cutoff = 0.001   // skip positions with germline AF above this threshold
    min_n_depth        = 10      // minimum normal depth for called variants
    trim_template      = 7       // ignore mutations within N bp of template ends
    trim_read          = 7       // ignore mutations within N bp of read ends
    mapq               = 40      // minimum mapping quality

    // ----------------------------------------------------------
    // Burden estimation options
    // ----------------------------------------------------------
    estimate_clonal    = false   // treat multi-molecule mutations as one
    estimate_dilute    = false   // sample and normal from same starting DNA material
    gene_bed           = null    // gene BED for per-gene duplex coverage (dNdScv)
}

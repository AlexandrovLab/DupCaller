// ============================================================
// DupCaller Pipeline — User Configuration
// Fill in the paths below, then run:
//   nextflow run DupCaller.nf -c pipeline.config
// ============================================================

params {

    // ----------------------------------------------------------
    // Input: sample map (required)
    // Tab-separated file with a header row and columns:
    //   sample_id  tumor_fastq_1  tumor_fastq_2  normal_fastq_1  normal_fastq_2
    // If normal_bam (below) is set, the normal_fastq_1/2 columns are not
    // read and may be omitted from the sample map entirely.
    // ----------------------------------------------------------
    sample_map = "sample.map"

    // ----------------------------------------------------------
    // Optional: reuse a single already-aligned, already-indexed (.bai)
    // normal BAM for every sample_id in the sample map, instead of
    // aligning a normal_fastq_1/2 pair per sample -- e.g. one matched
    // normal shared across many tumor-only benchmark/mock samples.
    // Skips trim/align/markdup for the normal entirely.
    // ----------------------------------------------------------
    normal_bam = null

    // ----------------------------------------------------------
    // Output directory
    // ----------------------------------------------------------
    outdir = "./results"

    // ----------------------------------------------------------
    // Reference genome (required)
    // Must already be indexed with samtools faidx, and (unless the matching
    // skip_* flag below is set to false) with DupCaller.py index and
    // bwa-mem2 index:
    //   samtools faidx produces:  reference.fa.fai
    //   DupCaller index produces: reference.fa.ref.h5, .tn.h5, .hp.h5, .str.h5, .dbs.h5
    //   bwa-mem2 index produces:  reference.fa.0123, .amb, .ann, .bwt.2bit.64, .pac
    // ----------------------------------------------------------
    reference      = null                    // path to your reference fasta -- required
    skip_index     = true                    // set false to run DupCaller.py index as Step 1
    skip_bwa_index = true                    // set false to run bwa-mem2 index as Step 1 (~90 GB RAM, ~1 h for GRCh38)

    // Required only when skip_index = false:
    repeat_tsv = null                        // PERF-format repeat tsv (chrom, start, end, motif, length, strand, num_units, motif_repeat) for DupCaller.py index

    // ----------------------------------------------------------
    // Resource files
    // Leave null to omit; germline_vcf and noise_mask are strongly recommended.
    // Every file below must be bgzip-compressed (.gz) with its tabix index
    // (.gz.tbi) next to it -- DupCaller opens them all with tabix, and the
    // pipeline stages the .tbi together with each file.
    // ----------------------------------------------------------
    germline_vcf = null   // germline VCF with AF field (.vcf.gz + .vcf.gz.tbi)
    noise_mask   = null   // noise mask BED (.bed.gz + .tbi), or a list of several, e.g. ["snp_mask.bed.gz", "noise_mask.bed.gz"]
    target_bed   = null   // optional: restrict calling to these regions (.bed.gz + .tbi)
    indel_bed    = null   // optional: indel-enhanced panel of normals (.bed.gz + .tbi)

    // ----------------------------------------------------------
    // Barcode pattern  (N = barcode base, X = skipped base)
    // NanoSeq default: NNNXXXX  (3-base barcode + 4 constant bases)
    // ----------------------------------------------------------
    barcode_pattern = "NNNXXXX"

    // ----------------------------------------------------------
    // Variant-calling regions
    // Default: human hg38 autosomes + X
    // Mouse example: "chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chrX"
    // ----------------------------------------------------------
    regions = (1..22).collect { "chr${it}" }.join(" ") + " chrX"

    // ----------------------------------------------------------
    // Compute resources
    // ----------------------------------------------------------
    // max_* cap every per-process request in nextflow.config. bwa-mem2 mem
    // on GRCh38 needs ~32 GB and bwa-mem2 index ~90 GB, so keep max_memory
    // at least that high for human data.
    threads  = 1     // threads for bwa-mem2 alignment and DupCaller variant calling
    max_cpus = 1
    max_memory = "96.GB"
    max_time   = "72.h"

    // ----------------------------------------------------------
    // Variant calling options (defaults are usually fine)
    // ----------------------------------------------------------
    max_af             = 1       // maximum tumor allele fraction to call a somatic mutation (-maf/--maxAF); matches DupCaller.py call's own default (1 = uncapped). NOT the same flag as --naf (max VAF in matched normal, a separate 0.01-default parameter this pipeline doesn't expose). Setting this below 1 makes DupCaller.py additionally require RAW tumor read depth >= ceil(1/max_af) at every position or mask it as insufficient normal coverage -- a value like 0.01 demands >=100x raw tumor depth everywhere and will silently collapse "Effective Read Families" to near zero on typical duplex-seq data.
    germline_af_cutoff = 0.001   // skip positions with germline AF above this threshold
    min_n_depth        = 10      // minimum normal depth for called variants
    trim_template      = 7       // ignore mutations within N bp of template ends
    trim_read          = 7       // ignore mutations within N bp of read ends
    mapq               = 40      // minimum mapping quality
    p_threshold        = null    // strand independence hypothesis SBS/indel filter (-pt/--p_threshold): per-strand p threshold (uncorrected); null = DupCaller.py call's default 0.05, 0 disables

    // ----------------------------------------------------------
    // Burden estimation options
    // ----------------------------------------------------------
    estimate_dilute    = false   // sample and normal from same starting DNA material (DupCaller.py estimate -d)
    gene_bed           = null    // gene BED (.bed.gz + .tbi; columns chrom, start, end, GENE_exon) for per-gene duplex coverage (dNdScv)
}
